# Required for the real backend (unless VITE_MOCK_MODE=true below).
# Get these from your Supabase project dashboard → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to run entirely on fixture data, with no Supabase project
# and no MTA API access required. See README.md → "Demo mode".
VITE_MOCK_MODE=false
